{
  "name": "screenshots",
  "productName": "screenshots",
  "version": "1.0.0",
  "description": "Electron 跨屏截图工具：框选标注、贴图、滚动长图、OCR",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "screenshots",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "get-windows": "^9.3.0",
    "koffi": "^3.3.2",
    "lucide-static": "^1.48.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "electron": "^44.4.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.4": true,
    "get-windows@9.3.0": true,
    "koffi@3.3.2": true
  },
  "author": {
    "name": "dsjerry"
  }
}
